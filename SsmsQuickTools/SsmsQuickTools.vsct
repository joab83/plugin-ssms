<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Extern href="KnownImageIds.vsct" />

  <Commands package="guidPackage">

    <Menus>
      <Menu guid="guidQuickToolsCmdSet" id="QuickConnectToolbar" priority="0x0000" type="Toolbar">
        <Parent guid="guidQuickToolsCmdSet" id="0" />
        <Strings>
          <ButtonText>SSMS Quick Tools</ButtonText>
          <CommandName>SSMS Quick Tools</CommandName>
        </Strings>
      </Menu>

      <!-- Menu top-level propio en la barra principal, junto a Herramientas: destino canonico de
           todos los comandos (ver docs/PLAN.md M5). Verificado contra SSMS 22.6 real: el merge
           funciona, pero SSMS cachea la barra de menus, asi que un cambio de .vsct requiere
           cerrar y reabrir SSMS por completo (no alcanza con reinstalar el .vsix) para que deje
           de verse gris/sin desplegar. -->
      <Menu guid="guidQuickToolsCmdSet" id="QuickToolsMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>Quick Tools</ButtonText>
          <CommandName>QuickTools</CommandName>
        </Strings>
      </Menu>

      <!-- Submenus dentro de Quick Tools que agrupan comandos por sobre que actuan: Query
           (editor de queries) y Results Grid (grid de resultados). -->
      <Menu guid="guidQuickToolsCmdSet" id="QueryMenu" priority="0x0100" type="Menu">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" />
        <Strings>
          <ButtonText>Query</ButtonText>
          <CommandName>Query</CommandName>
        </Strings>
      </Menu>

      <Menu guid="guidQuickToolsCmdSet" id="ResultsGridMenu" priority="0x0200" type="Menu">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" />
        <Strings>
          <ButtonText>Results Grid</ButtonText>
          <CommandName>ResultsGrid</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidQuickToolsCmdSet" id="QuickConnectToolbarGroup" priority="0x0000">
        <Parent guid="guidQuickToolsCmdSet" id="QuickConnectToolbar" />
      </Group>

      <!-- Grupo dentro del menu Quick Tools: contiene los submenus Query y Results Grid. -->
      <Group guid="guidQuickToolsCmdSet" id="QuickToolsMenuGroup" priority="0x0000">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenu" />
      </Group>

      <Group guid="guidQuickToolsCmdSet" id="QueryMenuGroup" priority="0x0000">
        <Parent guid="guidQuickToolsCmdSet" id="QueryMenu" />
      </Group>

      <Group guid="guidQuickToolsCmdSet" id="ResultsGridMenuGroup" priority="0x0000">
        <Parent guid="guidQuickToolsCmdSet" id="ResultsGridMenu" />
      </Group>

      <!-- Grupo fusionado en el popup real del grid de resultados (click derecho). -->
      <Group guid="guidQuickToolsCmdSet" id="ResultsGridContextGroup" priority="0x0F00">
        <Parent guid="guidSqlEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>

      <!-- Grupo propio para About, separado de los submenus Query/Results Grid por un divisor. -->
      <Group guid="guidQuickToolsCmdSet" id="AboutMenuGroup" priority="0x0900">
        <Parent guid="guidQuickToolsCmdSet" id="QuickToolsMenu" />
      </Group>

    </Groups>

    <Buttons>
      <Button guid="guidQuickToolsCmdSet" id="cmdidScriptDataCommand" priority="0x0110" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="ResultsGridMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ModifyQueryInsertValues" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Copy Selection as Script SELECT</ButtonText>
          <MenuText>Copy Selection as Script SELECT</MenuText>
          <ToolTipText>Generates a SELECT script from the result grid data and copies it to the clipboard</ToolTipText>
        </Strings>
      </Button>

      <!-- Generar CREATE / Generar ALTER: se intento primero como menu contextual del editor de
           codigo, pero el editor de query de SSMS arma su popup a mano y no fusiona grupos de
           terceros pese a aparecer como "customizable" en Personalizar (confirmado empiricamente
           contra SSMS 22.6). Quedan en Quick Tools + atajo, igual que ScriptData (ver docs/PLAN.md M3). -->
      <Button guid="guidEditorContextCmdSet" id="cmdidGenerateCreateCommand" priority="0x0100" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QueryMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Add" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Script Object as CREATE</ButtonText>
          <MenuText>Script Object as CREATE</MenuText>
        </Strings>
      </Button>

      <Button guid="guidEditorContextCmdSet" id="cmdidGenerateAlterCommand" priority="0x0110" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QueryMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Rename" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Script Object as ALTER</ButtonText>
          <MenuText>Script Object as ALTER</MenuText>
        </Strings>
      </Button>

      <Button guid="guidQuickToolsCmdSet" id="cmdidConnectionComboGetList" priority="0x0000" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QuickConnectToolbarGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Quick Connections</ButtonText>
        </Strings>
      </Button>

      <!-- Copiar seleccion del grid como XML Spreadsheet (Milestone 4, docs/PLAN.md). Se
           intento tambien fusionar en el menu contextual del grid de resultados
           (IDM_SQLWB_SQLRESGRID_CONTEXT) con GUID_SQLEditorCommandSet y no funciono; el IL de
           SQLEditors.dll muestra que SSMS muestra ese popup con GUID_SQLEditorGroup
           ({33F13AC3-...}, CommonUtils.DisplayPopupMenu), asi que se reintenta con ese guid via
           CommandPlacements (ver ResultsGridContextGroup). Tambien sigue en Quick Tools + atajo. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidCopyXmlSpreadsheetCommand" priority="0x0100" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="ResultsGridMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="OfficeExcel2013" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Copy Selection as SpreadSheet (Excel)</ButtonText>
          <MenuText>Copy Selection as SpreadSheet (Excel)</MenuText>
          <ToolTipText>Copies the result grid selection to the clipboard as an Excel-compatible XML Spreadsheet fragment, preserving type and precision</ToolTipText>
        </Strings>
      </Button>

      <!-- Auto Replacement (Milestone 6, docs/PLAN.md): expande el token pegado al cursor segun
           autoreplacement.xml. Se entrega tambien como filtro de comandos sobre Enter/Tab en el
           editor; este comando de menu+atajo es el plan C que garantiza que la funcion siga
           siendo usable si ese enganche deja de funcionar en una version futura de SSMS. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidExpandTokenCommand" priority="0x0120" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QueryMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Snippet" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Autoreplacement</ButtonText>
          <MenuText>Autoreplacement</MenuText>
          <ToolTipText>Expands the token glued to the cursor according to autoreplacement.xml</ToolTipText>
        </Strings>
      </Button>
      <!-- About: version y fecha de build, para saber que .vsix esta instalado durante pruebas. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidAboutCommand" priority="0x0000" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="AboutMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="StatusInformation" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>About</ButtonText>
          <MenuText>About</MenuText>
          <ToolTipText>Muestra la version y fecha de build de SsmsQuickTools</ToolTipText>
        </Strings>
      </Button>

      <!-- Locate in Object Explorer (spec 01): ubica y selecciona en el arbol de Object
           Explorer el objeto seleccionado o bajo el cursor en la query activa. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidLocateObjectCommand" priority="0x0130" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="QueryMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="GoToDefinition" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Locate in Object Explorer</ButtonText>
          <MenuText>Locate in Object Explorer</MenuText>
          <ToolTipText>Locates and selects the object under the cursor in the Object Explorer tree</ToolTipText>
        </Strings>
      </Button>

      <!-- Copy Selection as Comma List: una linea "a, b, c" por columna seleccionada, lista para
           pegar en un IN (...). Mismo patron que ScriptData / CopyXmlSpreadsheet. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidCopyCommaListCommand" priority="0x0120" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="ResultsGridMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Comma" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Copy Selection as Comma List</ButtonText>
          <MenuText>Copy Selection as Comma List</MenuText>
          <ToolTipText>Copies the selected result grid cells to the clipboard as a comma-separated list, one line per column</ToolTipText>
        </Strings>
      </Button>

      <!-- Copy All Headers / Copy Selected Headers (spec 03): nombres de columna como
           "[A], [B], [C]". Mismo patron que Comma List: menu Quick Tools + click derecho del grid. -->
      <Button guid="guidQuickToolsCmdSet" id="cmdidCopyAllHeadersCommand" priority="0x0130" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="ResultsGridMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="TableHeader" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Copy All Headers</ButtonText>
          <MenuText>Copy All Headers</MenuText>
          <ToolTipText>Copies all result grid column names to the clipboard as [A], [B], [C]</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidQuickToolsCmdSet" id="cmdidCopySelectedHeadersCommand" priority="0x0140" type="Button">
        <Parent guid="guidQuickToolsCmdSet" id="ResultsGridMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="SelectColumn" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Copy Selected Headers</ButtonText>
          <MenuText>Copy Selected Headers</MenuText>
          <ToolTipText>Copies the column names of the selected result grid cells to the clipboard as [A], [B], [C]</ToolTipText>
        </Strings>
      </Button>
    </Buttons>

    <Combos>
      <Combo guid="guidQuickToolsCmdSet" id="cmdidConnectionCombo" priority="0x0001" type="DropDownCombo"
             idCommandList="cmdidConnectionComboGetList" defaultWidth="220">
        <Parent guid="guidQuickToolsCmdSet" id="QuickConnectToolbarGroup" />
        <CommandFlag>IconAndText</CommandFlag>
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Quick Connections</ButtonText>
          <ToolTipText>Conexion rapida definida en connections.json; al elegir una, reconecta la ventana de query activa</ToolTipText>
        </Strings>
      </Combo>
    </Combos>

  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidQuickToolsCmdSet" id="cmdidScriptDataCommand" priority="0x0110">
      <Parent guid="guidQuickToolsCmdSet" id="ResultsGridContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidQuickToolsCmdSet" id="cmdidCopyXmlSpreadsheetCommand" priority="0x0120">
      <Parent guid="guidQuickToolsCmdSet" id="ResultsGridContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidQuickToolsCmdSet" id="cmdidCopyCommaListCommand" priority="0x0130">
      <Parent guid="guidQuickToolsCmdSet" id="ResultsGridContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidQuickToolsCmdSet" id="cmdidCopyAllHeadersCommand" priority="0x0140">
      <Parent guid="guidQuickToolsCmdSet" id="ResultsGridContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidQuickToolsCmdSet" id="cmdidCopySelectedHeadersCommand" priority="0x0150">
      <Parent guid="guidQuickToolsCmdSet" id="ResultsGridContextGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <!-- Acordes Ctrl+K, Ctrl+<n> en lugar de teclas unicas Ctrl+Shift+<letra>: ese espacio de una
       sola tecla esta tomado por comandos de VS/SSMS y es el que suelen tomar otras extensiones
       de terceros; el prefijo Ctrl+K con digitos esta prácticamente libre. -->
  <KeyBindings>
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidScriptDataCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="1" mod2="Control" />
    <KeyBinding guid="guidEditorContextCmdSet" id="cmdidGenerateCreateCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="2" mod2="Control" />
    <KeyBinding guid="guidEditorContextCmdSet" id="cmdidGenerateAlterCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="3" mod2="Control" />
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidCopyXmlSpreadsheetCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="4" mod2="Control" />
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidExpandTokenCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="5" mod2="Control" />
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidLocateObjectCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="6" mod2="Control" />
    <KeyBinding guid="guidQuickToolsCmdSet" id="cmdidCopyCommaListCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="7" mod2="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidPackage" value="{016d6f06-3db3-4bd2-a0b7-c19e4d1a3232}" />

    <GuidSymbol name="guidQuickToolsCmdSet" value="{2e7f3eab-6748-4aa6-bdcf-9c69e43a48fd}">
      <IDSymbol name="QuickConnectToolbar" value="0x1000" />
      <IDSymbol name="QuickConnectToolbarGroup" value="0x1001" />
      <IDSymbol name="QuickToolsMenu" value="0x1100" />
      <IDSymbol name="QuickToolsMenuGroup" value="0x1101" />
      <IDSymbol name="AboutMenuGroup" value="0x1102" />
      <IDSymbol name="QueryMenu" value="0x1110" />
      <IDSymbol name="QueryMenuGroup" value="0x1111" />
      <IDSymbol name="ResultsGridMenu" value="0x1120" />
      <IDSymbol name="ResultsGridMenuGroup" value="0x1121" />
      <IDSymbol name="ResultsGridContextGroup" value="0x1122" />

      <IDSymbol name="cmdidConnectionCombo" value="0x0100" />
      <IDSymbol name="cmdidConnectionComboGetList" value="0x0101" />

      <IDSymbol name="cmdidScriptDataCommand" value="0x0200" />
      <IDSymbol name="cmdidCopyXmlSpreadsheetCommand" value="0x0201" />
      <IDSymbol name="cmdidExpandTokenCommand" value="0x0202" />
      <IDSymbol name="cmdidAboutCommand" value="0x0203" />
      <IDSymbol name="cmdidLocateObjectCommand" value="0x0204" />
      <IDSymbol name="cmdidCopyCommaListCommand" value="0x0205" />
      <IDSymbol name="cmdidCopyAllHeadersCommand" value="0x0206" />
      <IDSymbol name="cmdidCopySelectedHeadersCommand" value="0x0207" />
    </GuidSymbol>

    <!-- GUID_SQLEditorGroup de SQLEditors.dll; 0x70 = IDM_SQLWB_SQLRESGRID_CONTEXT. -->
    <GuidSymbol name="guidSqlEditorGroup" value="{33F13AC3-80BB-4ecb-85BC-225435603A5E}">
      <IDSymbol name="IDM_SQLWB_SQLRESGRID_CONTEXT" value="0x0070" />
    </GuidSymbol>

    <GuidSymbol name="guidEditorContextCmdSet" value="{d71b3e2f-929e-4f15-9652-e299c6a4b288}">
      <IDSymbol name="cmdidGenerateCreateCommand" value="0x0300" />
      <IDSymbol name="cmdidGenerateAlterCommand" value="0x0301" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
